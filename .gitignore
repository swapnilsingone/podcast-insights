# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets / env
.env
.env.local
.env.*

# macOS
.DS_Store

# Audio sources (re-downloadable via yt-dlp; large)
videos/*/source/*.m4a
videos/*/source/*.mp3
videos/*/source/*.wav

# Raw transcription dumps (regenerable; transcript.txt/json are the canonical form)
videos/*/source/*.groq.json
videos/*/source/*.whisperx.json

# Local session state
library/.last_seen_tracker.json

# Runtime logs (regenerable; transient)
*.log

# Per-video reprocess/backend-switch backups (local recovery only)
videos/*/.groq-backup/
videos/*/.reprocess-backup/

# Editors
.vscode/
.idea/
*.swp
